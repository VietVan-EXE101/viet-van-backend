# Render runtime. Enter real values in Render Environment, never commit a real .env.
ASPNETCORE_ENVIRONMENT=Production
PORT=10000
Swagger__Enabled=true
# Render supplies RENDER=true automatically; set it only when emulating Render locally.
# RENDER=true
# Template only: replace the entire value with Somee > Database > Connection details > Connection string.
# The hostname uses a dot, not a backslash before the dot. Preserve Somee's actual TLS settings.
ConnectionStrings__DefaultConnection=Server=VietVan_New.mssql.somee.com;Database=VietVan_New;User Id=zinnkh0401_SQLLogin_1;Password=REPLACE_WITH_SOMEE_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30
Jwt__Key=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
Jwt__Issuer=VietVan.API
Jwt__Audience=VietVan.Client
Jwt__ExpiryMinutes=120
AllowedHosts=your-service.onrender.com;localhost
Cors__AllowedOrigins__0=https://frontend.example.com
# Add another exact origin only when needed:
# Cors__AllowedOrigins__1=http://localhost:3001
GoogleSignIn__ClientId=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Strict for HTTPS same-site deployment; None for cross-site FE/API, requiring HTTPS.
GoogleSignIn__ChallengeCookieSameSite=None
Email__Provider=Resend
Email__Resend__ApiKey=REPLACE_RESEND_API_KEY
Email__Resend__FromAddress=noreply@example.com
Email__VerificationBaseUrl=https://your-service.onrender.com
# Optional. Leave empty to send the reset code without a frontend reset link.
Email__PasswordResetUrl=
SePay__BankId=YOUR_BANK_CODE
SePay__BankName=YOUR_BANK_NAME
SePay__AccountNumber=YOUR_BANK_ACCOUNT
SePay__AccountHolder=YOUR_ACCOUNT_HOLDER
SePay__WebhookApiKey=REPLACE_WITH_RANDOM_SEPAY_KEY_AT_LEAST_24_CHARACTERS
SePay__OrderLifetimeMinutes=15
# Local disk is ephemeral on Render Free. See README before uploading durable media.
Storage__RootPath=/app/PrivateMedia
DevelopmentAdmin__Enabled=false
# SMTP remains available for localhost/other hosts; not recommended on Render Free.
# Email__Smtp__Host=smtp.example.com
# Email__Smtp__Port=587
# Email__Smtp__UserName=YOUR_SMTP_USER
# Email__Smtp__Password=REPLACE_SMTP_PASSWORD
# Email__Smtp__FromAddress=noreply@example.com
